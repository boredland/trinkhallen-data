{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinkhallen.app/schema/kiosk.schema.json",
  "title": "Kiosk Feature",
  "description": "A single Trinkhalle / Späti / Wasserhäuschen as a GeoJSON Feature.",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "Feature" },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "items": { "type": "number" }
        }
      }
    },
    "properties": {
      "type": "object",
      "required": ["id", "name", "address"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tk_[a-z0-9]+_[a-z0-9_-]+$",
          "description": "Stable region-prefixed identifier, e.g. tk_fr_001."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "street":     { "type": "string", "maxLength": 200 },
            "number":     { "type": "string", "maxLength": 20 },
            "postalcode": { "type": "string", "pattern": "^[0-9]{5}$" },
            "city":       { "type": "string", "maxLength": 100 },
            "district":   { "type": "string", "maxLength": 100 }
          }
        },
        "hours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw": {
              "type": "string",
              "description": "OSM opening_hours string, parseable by opening_hours.js."
            }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "payment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cash":        { "$ref": "#/$defs/triState" },
            "cards":       { "$ref": "#/$defs/triState" },
            "contactless": { "$ref": "#/$defs/triState" },
            "girocard":    { "$ref": "#/$defs/triState" },
            "mobile":      { "$ref": "#/$defs/triState" }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "additionalProperties": false,
            "properties": {
              "type":    { "enum": ["osm", "hopfenstop", "user", "manual"] },
              "id":      { "type": "string" },
              "version": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "osm_removed": {
          "type": "boolean",
          "description": "Set to true by the OSM workflow when an OSM-sourced node has disappeared upstream; humans review before deletion."
        },
        "kind": {
          "enum": ["vending_machine"],
          "description": "Set when OSM tags identify the feature as something more specific than a manned kiosk (currently: pure vending machines via amenity=vending_machine, self_service=only, or automated=yes). Consumers can filter or render differently."
        },
        "created": { "type": "string", "format": "date" },
        "updated": { "type": "string", "format": "date" }
      }
    }
  },
  "$defs": {
    "triState": { "enum": ["yes", "no", "unknown"] }
  }
}
